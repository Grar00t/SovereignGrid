<Window
    x:Class="SovereignGrid.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SovereignGrid"
    Width="1200"
    Height="800">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock
                FontSize="36"
                FontWeight="Bold"
                Text="{Binding ProductName}" />

            <TextBlock
                Margin="0,5,0,0"
                Text="{Binding Status}" />

            <TextBlock
                Margin="0,5,0,0"
                Text="{Binding Mode}" />

            <TextBlock
                Margin="0,5,0,20"
                Text="{Binding Version}" />

            <Border
                Padding="20"
                BorderThickness="1">

                <TextBlock
                    FontSize="20"
                    Text="Workbook Engine Connected" />

            </Border>

        </StackPanel>

    </Grid>

</Window>
