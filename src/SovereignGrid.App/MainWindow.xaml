<Window
    x:Class="SovereignGrid.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SovereignGrid" Width="1500" Height="920"
    FlowDirection="LeftToRight" FontFamily="Segoe UI">
  <DockPanel>

    <!-- Title bar -->
    <Border DockPanel.Dock="Top" Background="#1E3A5F" Padding="14,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="SovereignGrid" Foreground="White" FontSize="17" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="0,0,24,0"/>
        <TextBlock Text="Source:" Foreground="#B9C6D8" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Name="ConnectorBox" Width="170" VerticalAlignment="Center"/>
        <Button Name="OpenButton" Content="Import" Margin="8,0,0,0" Padding="12,4"/>
      </StackPanel>
    </Border>

    <!-- Ribbon -->
    <ToolBarTray DockPanel.Dock="Top" Background="#F3F5F8" IsLocked="True">

      <ToolBar Header="File" Band="1">
        <Button Name="NewButton"  Content="New"     Padding="8,3"/>
        <Button Name="OpenFileBtn" Content="Open"    Padding="8,3"/>
        <Button Name="SaveButton" Content="Save"    Padding="8,3"/>
        <Button Name="SaveAsBtn"  Content="Save As" Padding="8,3"/>
      </ToolBar>

      <ToolBar Band="1">
        <Button Name="UndoBtn" Content="↶ Undo" Padding="6,3"/>
        <Button Name="RedoBtn" Content="↷ Redo" Padding="6,3"/>
        <Separator/>
        <Button Name="CutBtn"   Content="Cut"   Padding="6,3"/>
        <Button Name="CopyBtn"  Content="Copy"  Padding="6,3"/>
        <Button Name="PasteBtn" Content="Paste" Padding="6,3"/>
      </ToolBar>

      <ToolBar Band="2">
        <ComboBox Name="FontBox"  Width="150" IsEditable="True"/>
        <ComboBox Name="SizeBox"  Width="55"  IsEditable="True"/>
        <Separator/>
        <ToggleButton Name="BoldBtn"      Content="B"  FontWeight="Bold"   Width="30"/>
        <ToggleButton Name="ItalicBtn"    Content="I"  FontStyle="Italic"  Width="30"/>
        <ToggleButton Name="UnderlineBtn" Content="U"  Width="30"/>
        <Separator/>
        <Button Name="TextColorBtn" Content="A ▾" Padding="6,3"/>
        <Button Name="FillColorBtn" Content="🖌 ▾" Padding="6,3"/>
      </ToolBar>

      <ToolBar Band="2">
        <Button Name="AlignLeftBtn"   Content="⟵" Width="32"/>
        <Button Name="AlignCenterBtn" Content="≡" Width="32"/>
        <Button Name="AlignRightBtn"  Content="⟶" Width="32"/>
        <Separator/>
        <Button Name="MergeBtn"   Content="Merge"   Padding="6,3"/>
        <Button Name="UnmergeBtn" Content="Unmerge" Padding="6,3"/>
      </ToolBar>

      <ToolBar Band="3">
        <Button Name="FmtNumberBtn"   Content="1,000.00" Padding="6,3"/>
        <Button Name="FmtCurrencyBtn" Content="$" Padding="10,3"/>
        <Button Name="FmtPercentBtn"  Content="%"        Padding="8,3"/>
        <Button Name="FmtDateBtn"     Content="Date"     Padding="6,3"/>
      </ToolBar>

      <ToolBar Band="3">
        <Button Name="BorderAllBtn"     Content="Borders"  Padding="6,3"/>
        <Button Name="BorderOutlineBtn" Content="Outline"  Padding="6,3"/>
        <Button Name="BorderNoneBtn"    Content="No Border" Padding="6,3"/>
        <Separator/>
        <Button Name="TableStyleBtn" Content="Format as Table" Padding="8,3"/>
      </ToolBar>

      <ToolBar Band="3">
        <Button Name="InsRowBtn" Content="+Row"  Padding="6,3"/>
        <Button Name="InsColBtn" Content="+Col"  Padding="6,3"/>
        <Button Name="DelRowBtn" Content="-Row"  Padding="6,3"/>
        <Button Name="DelColBtn" Content="-Col"  Padding="6,3"/>
        <Separator/>
        <Button Name="RtlButton" Content="RTL/LTR" Padding="6,3"/>
      </ToolBar>
      <ToolBar Band="1">
        <Button Name="SaveSgBtn" Content=".sgrid Save" Padding="8,3"/>
        <Button Name="OpenSgBtn" Content=".sgrid Open" Padding="8,3"/>
        <Separator/>
        <Button Name="ChartColBtn"  Content="Column Chart" Padding="8,3"/>
        <Button Name="ChartLineBtn" Content="Line Chart"   Padding="8,3"/>
        <Button Name="ChartPieBtn"  Content="Pie Chart"    Padding="8,3"/>
      </ToolBar>
      <ToolBar Band="1">
        <Button Name="FilterBtn"   Content="AutoFilter"    Padding="8,3"/>
        <Button Name="FreezeBtn"   Content="Freeze"        Padding="8,3"/>
        <Button Name="UnfreezeBtn" Content="Unfreeze"      Padding="8,3"/>
        <Separator/>
        <Button Name="ExportPngBtn" Content="Chart to PNG" Padding="8,3"/>
      </ToolBar>

    </ToolBarTray>

    <Border DockPanel.Dock="Bottom" Background="#1E3A5F" Padding="10,3">
      <StackPanel Orientation="Horizontal">
        <TextBlock Name="CellRefText"  Foreground="White" Margin="0,0,20,0" Text="A1"/>
        <TextBlock Name="StatsText"    Foreground="#B9C6D8" Text=""/>
      </StackPanel>
    </Border>
    <Grid Name="RootGrid"/>
  </DockPanel>
</Window>


