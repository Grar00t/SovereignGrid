<Window
    x:Class="SovereignGrid.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SovereignGrid" Width="1400" Height="900"
    FlowDirection="LeftToRight" FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E3A5F" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SovereignGrid" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Source:" Foreground="#B9C6D8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Name="ConnectorBox" Width="180" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Name="OpenButton" Content="Open / Import" Margin="4,0" Padding="10,4"/>
                <Button Name="SaveButton" Content="Save .xlsx"    Margin="4,0" Padding="10,4"/>
                <Button Name="RtlButton"  Content="RTL / LTR"     Margin="4,0" Padding="10,4"/>
            </StackPanel>
        </Border>
        <Grid Name="RootGrid"/>
    </DockPanel>
</Window>
