<Window
    x:Class="SovereignGrid.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SovereignGrid"
    Width="1100"
    Height="700">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock
                FontSize="32"
                FontWeight="Bold"
                Text="SovereignGrid" />

            <TextBlock
                Margin="0,10,0,0"
                FontSize="16"
                Text="Local-First Spreadsheet Workspace" />

            <Separator Margin="0,20,0,20"/>

            <TextBlock Text="Status: Initialized"/>
            <TextBlock Text="Mode: Local First"/>
            <TextBlock Text="Version: 0.1.0-dev"/>

        </StackPanel>

    </Grid>

</Window>
